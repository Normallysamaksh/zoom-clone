# Local development: the Next.js server forwards /api/v1 to FastAPI.
# Leave BACKEND_URL unset on Vercel; vercel.json routes both services.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEMO_MODE=false

# Hosted SQLite for Vercel. These variables belong to the backend service.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token

# Optional TURN configuration for calls between restricted networks.
# Public browser configuration: use scoped/temporary TURN credentials.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-relay.example:3478","username":"user","credential":"temporary-password"}]

# Backend environment (set in shell locally or Vercel backend service settings):
# DATABASE_PATH=data/meetings.db
# SEED_SAMPLE_DATA=true
# ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
